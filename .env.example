# Backend settings (all optional; defaults shown)

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Requests per minute allowed per client address on the debate endpoints
RATE_LIMIT_PER_MINUTE=10

# Models. Gemini is used when the user supplies an API key (X-Api-Key header); otherwise local Ollama.
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=gemma3:latest
# OLLAMA_BASE_URL=http://localhost:11434

# Rate-limit retries for LLM calls (seconds grow by 1.5x with jitter)
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=15

# How long market data and news are reused (seconds)
DATA_CACHE_TTL_SECONDS=300

# Quantitative signals (volatility forecast). QUANT_DEFAULT_MODEL: long_run (one-year average, recommended), ewma, naive,
# or garch / garch_t / gjr (these need the `arch` package from requirements-dev.txt and are slower).
QUANT_ENABLED=true
QUANT_DEFAULT_MODEL=long_run
QUANT_FORECAST_TTL_SECONDS=3600
PRICE_HISTORY_TTL_SECONDS=3600

# Client address behind reverse proxies. Set to the number of proxies in front of the app (Render, Fly and Railway: 1)
# so the rate limit counts real visitors, not the proxy. 0 = use the socket address and ignore X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# Optional cost estimate shown on the page: USD per million tokens for the model you use (look up current prices).
# Left unset, only token counts are shown.
# GEMINI_INPUT_USD_PER_M=
# GEMINI_OUTPUT_USD_PER_M=

# Demo mode: visitors with no key use YOUR key, limited per visitor and in total per day (counts reset on restart, so
# also set a spend limit on the key itself). Off unless DEMO_API_KEY is set. Never commit a real key.
# DEMO_API_KEY=
# DEMO_MODEL=
DEMO_PER_VISITOR_PER_DAY=3
DEMO_GLOBAL_PER_DAY=50
